# Cloudflare Workers static-assets headers.
# NOTE: vinext only writes its own default _headers when this file is absent,
# so the content-hashed /assets/* rule is repeated here.

# Content-hashed build output: safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Un-hashed media and icons: cache for a week and revalidate in the background.
# Publish a changed file under a new name (or add ?rev=...) to bust sooner.
/*.mp4
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.vtt
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
